{
  "name": "process-tracker-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create process-tracker-db",
    "db:migrate:local": "wrangler d1 migrations apply process-tracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply process-tracker-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}